# Copy to .env.local to override. Never commit real secrets.

# Where the dev server proxies /v1 (REST + WebSocket). Default: http://localhost:8081
PLAYHOOT_BACKEND_URL=http://localhost:8081

# Backend base URL used by the browser. Empty = same origin (the dev proxy). Only set it for a
# deployment where the backend is on another origin (the backend then needs CORS and allowed origins).
VITE_API_BASE_URL=

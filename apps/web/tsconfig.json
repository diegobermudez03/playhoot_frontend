{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // React Router writes the route types here (`react-router typegen`).
    "rootDirs": [".", "./.react-router/types"],
    "types": ["node"]
  },
  "include": ["src", ".react-router/types/**/*"],
  // The service worker has its own scope and its own check (tsconfig.sw.json).
  "exclude": ["src/pwa/sw.ts"]
}
